# 环境配置
PROJECT_NAME=Wedding Ceremony Agent
VERSION=0.1.0

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data.db
MYSQL_DATABASE_URL=mysql+aiomysql://root:password@192.168.1.19:3306/wedding

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM配置
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=

# Agent配置
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=60

# JWT鉴权配置
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
